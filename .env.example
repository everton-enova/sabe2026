SABE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxvgwFg4DLt4E-k7tQMoB7wPlwjVO7oBi_5NIMeLT7f5bQtJEgw5RJ8_9VgGC0fnw1ojw/exec
SABE_WEBHOOK_SECRET=troque-por-um-segredo-forte
# Opcional: protege /api/diagnostico. Sem ela o endpoint responde 404.
SABE_DIAGNOSTICO_SECRET=troque-por-outro-segredo
# Supabase Storage: upload dos PDFs do SM (elimina timeout do Drive).
NEXT_PUBLIC_SUPABASE_URL=https:// SUA_URL .supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ SUA_CHAVE
# Service role key (somente servidor) — se nao existir, usa a publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: Cloudflare Turnstile (anti-bot). Cadastre o par sitekey/secret para ativar.
# Enquanto nao existirem, o formulario funciona sem a verificacao.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
